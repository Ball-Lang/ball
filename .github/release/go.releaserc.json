{
  "branches": ["main"],
  "tagFormat": "go-modules/v${version}",
  "plugins": [
    ["./tools/release/only-package-commits.mjs", { "paths": ["go"] }],
    ["@semantic-release/changelog", { "changelogFile": "go/CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "verifyReleaseCmd": "bash tools/go-module-proxy/bump_go_modules.sh --check-next v${nextRelease.version} --type ${nextRelease.type}",
      "prepareCmd": "bash tools/go-module-proxy/bump_go_modules.sh v${nextRelease.version}",
      "publishCmd": "gh workflow run tag-go-modules.yml --ref go-modules/v${nextRelease.version}"
    }],
    ["@semantic-release/git", {
      "assets": ["go/go.work", "go/*/go.mod", "go/cli/version.go", "tools/coverage-study/go/go.mod", "go/CHANGELOG.md"],
      "message": "chore(release): go v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", { "successComment": false }]
  ]
}
