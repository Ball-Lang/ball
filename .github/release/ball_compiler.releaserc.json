{
  "branches": ["main"],
  "tagFormat": "ball_compiler-v${version}",
  "plugins": [
    ["./tools/release/only-package-commits.mjs", { "paths": ["dart/compiler"] }],
    ["@semantic-release/changelog", { "changelogFile": "dart/compiler/CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "verifyReleaseCmd": "node tools/release/lockstep_plan.mjs --record --package=ball_compiler --version=${nextRelease.version} --type=${nextRelease.type}",
      "prepareCmd": "node tools/release/set_manifest_version.mjs --format=pubspec --file=dart/compiler/pubspec.yaml --version=${nextRelease.version} && node tools/release/sync_pubspec_deps.mjs --workspace-root=.",
      "publishCmd": "gh workflow run release-publish.yml --ref ball_compiler-v${nextRelease.version}"
    }],
    ["@semantic-release/git", {
      "assets": ["dart/compiler/pubspec.yaml", "dart/*/pubspec.yaml", "dart/compiler/CHANGELOG.md"],
      "message": "chore(release): ball_compiler ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", { "successComment": false }]
  ]
}
